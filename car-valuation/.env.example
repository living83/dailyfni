# ===========================================================================
# car-valuation — sample environment file
# Copy to `.env` (local) or `.env.server` (server). Both are gitignored.
# Empty values fall back to the defaults defined in config.py.
# ===========================================================================

# --- Storage paths --------------------------------------------------------
DB_PATH=

# --- Cache & concurrency --------------------------------------------------
CACHE_TTL_DAYS=
SCRAPER_CONCURRENCY=

# --- Scrape behavior (anti-detection) -------------------------------------
SCRAPE_DELAY_MIN=
SCRAPE_DELAY_MAX=
SCRAPER_MAX_RETRIES=
SCRAPER_BLOCKED_WAIT_SEC=

# --- Model matching -------------------------------------------------------
FUZZY_MATCH_THRESHOLD=

# --- Valuation weights (step 6) -------------------------------------------
WEIGHT_ENCAR=
WEIGHT_KBCHACHACHA=
WEIGHT_HEYDEALER=
AUCTION_DISCOUNT_RATIO=

# --- Proxy (Decodo KR ISP IPs, optional) ---------------------------------
PROXY_ENABLED=
PROXY_HOST=
PROXY_PORT=
PROXY_PORT_END=
PROXY_USER=
PROXY_PASS=

# --- Service --------------------------------------------------------------
FASTAPI_PORT=
LOG_LEVEL=
TZ=
